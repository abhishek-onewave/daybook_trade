APP_ENVIRONMENT=development
# Temporary zero-credential preview only. Keep false when connecting Supabase
# or any real integration.
DAYBOOK_DEMO_MODE=false
ANTHROPIC_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Tastytrade OAuth2 app credentials (developer portal), READ-ONLY usage
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_ENV=sandbox
FINNHUB_API_KEY=
DAYBOOK_DAILY_CHAT_CAP=300
# Local development uses SQLite. On Vercel, replace this with the dedicated
# Supabase transaction-pooler URI (port 6543) and require SSL.
DATABASE_URL=sqlite:///./data/daybook.db
# Generate one server-only value used by the Web gateway and private backend.
DAYBOOK_API_TOKEN=
# Use a separate high-entropy single-user password.
DAYBOOK_ACCESS_PASSWORD=
# Generate a strong random value before enabling encrypted broker token storage.
SECRET_KEY=
